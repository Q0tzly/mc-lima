# ==========================================
# Minecraft Server Configuration
# ==========================================

# Server type: PAPER (recommended), PURPUR, FABRIC, VANILLA, FORGE, NEOFORGE, SPIGOT
SERVER_TYPE=PAPER

# Minecraft version: LATEST or specific versions like 1.21.4, 1.20.4
SERVER_VERSION=LATEST

# Server memory allocation (Java heap): e.g. 2G, 4G, 8G
MEMORY=4G

# Port for Minecraft clients to connect
SERVER_PORT=25565

# Server Message of the Day shown in client server list
MOTD=Minecraft Server on Lima

# Game difficulty: peaceful, easy, normal, hard
DIFFICULTY=normal

# Maximum players allowed simultaneously
MAX_PLAYERS=20

# Online mode (TRUE: verify with Mojang/Microsoft account, FALSE: offline/cracked)
ONLINE_MODE=TRUE

# Operators (comma-separated usernames to grant operator permissions automatically)
# Example: OPS=notch,jeb_
OPS=

# Remote Console (RCON) password
RCON_PASSWORD=minecraft

# View distance (chunks, 3-32)
VIEW_DISTANCE=10

# Allow command blocks
ENABLE_COMMAND_BLOCK=true

# Spawn protection radius (0 disables protection)
SPAWN_PROTECTION=0

# ==========================================
# Lima Virtual Machine Configuration
# ==========================================

# Lima VM instance name
LIMA_INSTANCE=mc-lima

# CPU cores allocated to the Lima VM
VM_CPUS=4

# Memory allocated to the Lima VM (should be larger than MEMORY above)
VM_MEMORY=6GiB

# Disk space allocated to the Lima VM
VM_DISK=30GiB
